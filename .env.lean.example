# Copy to .env.lean and fill in secrets. Never commit .env.lean.
# Database + Redis: inside Compose, URLs use hostnames postgres / redis.
#
# Same host, new clone path (e.g. oziebot → oziebot-v2-backend): set a stable
# project name so you do not get a second stack (duplicate Caddy on :80/:443, duplicate Postgres ports).
# REQUIRED for lean edge (Caddy) unless this host runs only one compose project ever.
COMPOSE_PROJECT_NAME=oziebot

# REDIS_URL must stay redis://redis:6379/0 for inter-container networking.
#
# Docker maps Postgres to host 127.0.0.1:15432 and Redis to 127.0.0.1:16379 when defaults apply
# (avoid clashes with locally installed Postgres/Redis).
DATABASE_URL=postgresql+psycopg://oziebot:CHANGE_ME_DB_PASSWORD@postgres:5432/oziebot
REDIS_URL=redis://redis:6379/0

POSTGRES_USER=oziebot
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=oziebot

# Bind API: 127.0.0.1 (SSH tunnel / local reverse proxy) or 0.0.0.0 (public—use firewall + TLS)
LEAN_API_BIND=127.0.0.1

APP_ENV=production
CORS_ORIGINS=https://app.oziebot.com
RUN_DB_MIGRATIONS_ON_STARTUP=1

# API (required in production)
JWT_SECRET=change-me-min-32-chars-use-openssl-rand-hex-32
EXCHANGE_CREDENTIALS_ENCRYPTION_KEY=
COINBASE_API_BASE_URL=https://api.coinbase.com

# Stripe (optional; leave empty if unused)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=https://app.oziebot.com/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=https://app.oziebot.com/billing/cancel

# Strategy / trading mode
OZIEBOT_STRATEGY_DEMO=0
OZIEBOT_TRADING_MODE=paper
OZIEBOT_STRATEGY_RUNNER_POLL_SEC=1.0

# Risk freshness (seconds)
RISK_STALE_TRADE_SECONDS=20
RISK_STALE_BBO_SECONDS=15
RISK_STALE_CANDLE_SECONDS=180

# Execution (paper defaults okay for validation)
PAPER_DEFAULT_FEE_BPS=15
PAPER_DEFAULT_SLIPPAGE_BPS=8
RECONCILIATION_INTERVAL_SECONDS=60

# Alerts (Slack/Telegram/SMS—leave empty to disable)
NOTIFY_MAX_RETRIES=3
SMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=

# Market data (Coinbase Advanced Trade)
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com
COINBASE_REST_URL=https://api.coinbase.com/api/v3/brokerage
CANDLES_GRANULARITY_SEC=60
RAW_TRADE_LOG_ENABLED=false
OPS_ALERTS_ENABLED=false
SIGNAL_PANEL_ENABLED=true

# Optional: larger API container on 8GB+ hosts
# API_MEMORY_LIMIT=1536M

# Optional: tune noisy log thresholds (ms)
API_SLOW_REQUEST_MS=2000
API_SLOW_QUERY_MS=500

# Do NOT set OBSERVABILITY_S3_* here unless you want S3 heartbeats; lean stack uses Redis-only.
